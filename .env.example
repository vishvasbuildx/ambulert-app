# AMBULERT - Environment Configuration Template

# Server Port
PORT=5000

# Databases
# Set MONGO_URI to connect to MongoDB, if unavailable the backend falls back to memory safely
MONGO_URI=mongodb://localhost:27017/ambulert
# Set REDIS_URL to connect to Redis GEO, if unavailable the backend falls back to memory safely
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=super_secret_session_key_for_ambulert_jwt_tokens

# Map Configuration
# Leaflet maps use OSM, but if developers want Mapbox customization they can add their token here
MAPBOX_ACCESS_TOKEN=pk.mapbox_token_placeholder

# Artificial Intelligence Routing Assistant (Gemini / OpenAI API Key)
AI_API_KEY=gemini_developer_key_placeholder

# Mock OTP/SMS Settings
MOCK_SMS_PROVIDER=true
MOCK_OTP_CODE=123456
